[Unit]
Description=LIRA 设备端主循环（语音唤醒/对话/阅读）
# user unit（systemctl --user）：依赖 orangepi 用户的 PipeWire 会话；
# Linger=yes（已开）使其开机自启，无需桌面登录。
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/orangepi/lira/device
# 与 start-lira.sh 同纪律：启动前清旧字节码（scp 更新源码后 pyc 未失效会崩 AttributeError）
ExecStartPre=/bin/sh -c 'find /home/orangepi/lira/device/lira -name __pycache__ -exec rm -rf {} +'
ExecStart=/home/orangepi/lira/device/.venv/bin/python -m lira.main
# M7 实机验证期开开发者控制台（产线改为 0 或删本行，config dev_console.enabled 同步关）
Environment=LIRA_DEV_CONSOLE=1
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
